{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": false,
        "jsx": "react-jsx",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "noEmit": true,
        "strict": true,
        "target": "ES2022",
        "paths": { "@/*": ["./resources/js/*"] }
    },
    "include": ["resources/js/**/*"]
}
